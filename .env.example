# development | alpha | staging | production
# Closed Alpha must use APP_ENV=alpha so production-like security rules apply.
APP_ENV=development

# Required by scripts/alpha_reset.sh when intentionally resetting an isolated alpha environment.
# Set to a unique non-production instance identifier, e.g. gb-alpha-eu1.
ALPHA_INSTANCE_ID=
ALPHA_RESET_CONFIRM=
POSTGRES_DB=greenbusiness
POSTGRES_USER=greenbusiness
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://greenbusiness:change-me@postgres:5432/greenbusiness

JWT_SECRET=change-me-with-at-least-32-random-bytes
JWT_ISSUER=greenbusiness
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=2592000
REFRESH_COOKIE_NAME=gb_refresh
COOKIE_SECURE=false

ADMIN_API_KEY=change-me-admin-key
ADMIN_JWT_SECRET=change-me-admin-jwt-secret
ADMIN_ACTOR_ID=local-admin
ADMIN_ROLE=superadmin
ADMIN_TOKEN_TTL_SECONDS=900

CREATOR_ACCESS_ENABLED=false
CREATOR_EMAIL=creator@greenbusiness.local
CREATOR_DISPLAY_NAME=Creator

SANDBOX_MONETIZATION_ENABLED=true
SANDBOX_REWARDED_ADS_ENABLED=true

REDIS_URL=redis://redis:6379/0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis

# Fernet key. Required explicitly in production.
PUSH_TOKEN_ENCRYPTION_KEY=
ANALYTICS_REQUEST_SAMPLE_RATE=0.1

STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/data/greenbusiness
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

NEXT_PUBLIC_API_URL=/api
