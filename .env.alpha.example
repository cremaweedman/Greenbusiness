APP_ENV=alpha
ALPHA_INSTANCE_ID=gb-alpha-eu1
ALPHA_BASE_URL=https://alpha.example.com
ALPHA_HTTP_PORT=8080

POSTGRES_DB=greenbusiness_alpha
POSTGRES_USER=greenbusiness_alpha
POSTGRES_PASSWORD=replace-with-strong-random-secret
DATABASE_URL=postgresql+asyncpg://greenbusiness_alpha:replace-with-strong-random-secret@postgres:5432/greenbusiness_alpha

JWT_SECRET=replace-with-32-plus-random-bytes
JWT_ISSUER=greenbusiness-alpha
COOKIE_SECURE=true

ADMIN_API_KEY=replace-with-32-plus-random-bytes
ADMIN_JWT_SECRET=replace-with-different-32-plus-random-bytes
ADMIN_ACTOR_ID=alpha-bootstrap-admin
ADMIN_ROLE=superadmin

CREATOR_ACCESS_ENABLED=false
SANDBOX_MONETIZATION_ENABLED=false
SANDBOX_REWARDED_ADS_ENABLED=false

REDIS_URL=redis://redis:6379/0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PUSH_TOKEN_ENCRYPTION_KEY=
ANALYTICS_REQUEST_SAMPLE_RATE=1.0

STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/data/greenbusiness
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

NEXT_PUBLIC_API_URL=/api
